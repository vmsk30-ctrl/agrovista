# AGROVISTA ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env.local for local development.
# Do NOT commit .env.local or production secrets to Git.

# 1. DATABASE (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...[YOUR-SERVICE-ROLE-KEY]

# 2. MOBILE OTP AUTHENTICATION (Indian SMS Gateway - Fast2SMS / MSG91)
# Leave empty to utilize built-in test sandbox mode
OTP_PROVIDER_API_KEY=
OTP_PROVIDER_SECRET=agrovista_secret_salt_2026

# 3. ONLINE PAYMENTS (Razorpay Sandbox / Test Mode)
# Leave empty to utilize built-in test sandbox mode
RAZORPAY_KEY_ID=rzp_test_agrovista_sandbox
RAZORPAY_KEY_SECRET=agrovista_sandbox_secret_key_2026
RAZORPAY_WEBHOOK_SECRET=agrovista_webhook_secret_2026

# 4. AGRICULTURAL MARKET INTELLIGENCE (Agmarknet / Data.gov.in)
# Leave empty to utilize verified Telangana morning yard baseline
MARKET_API_KEY=

# 5. AGRO-WEATHER API (Open-Meteo is free & keyless; optional custom provider key)
WEATHER_API_KEY=

# 6. AI CROP & PRICE PREDICTION MICROSERVICE
AI_API_KEY=
ML_SERVICE_URL=

# 7. APPLICATION MODE
DEMO_MODE=true
